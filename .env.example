# Hedera testnet operator account. This account pays every transaction fee and is the
# agent identity that signs analysis messages.
ACCOUNT_ID=0.0.12345
PRIVATE_KEY=

# Anthropic API key for the SLM classifier (layer 3) and the report agent.
ANTHROPIC_API_KEY=

# HCS topic ids — created by `npm run setup:topics`, which prints this whole block.
TOPIC_TELEMETRY=
TOPIC_ANALYSIS=
TOPIC_REPORTS=
TOPIC_DECISIONS=

# Boiler gateway key. Only this key may submit to the telemetry topic, which is what
# makes a reading attributable to a device. Generated by `npm run setup:topics`.
DEVICE_PRIVATE_KEY=

# Operator key allowed to submit decisions. For real operators set OPERATOR_PUBLIC_KEYS
# (comma-separated) and OPERATOR_THRESHOLD instead, and setup-topics builds a threshold
# KeyList so a decision needs multiple signatures.
OPERATOR_PRIVATE_KEY=
